{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "App Electron con Django + Python Portable",
  "main": "main.js",
  "scripts": {
    "start": "npm run build-frontend && electron .",
    "build-frontend": "cd ../frontend && npm install && npm run build && xcopy dist ..\\electron-app\\frontend\\dist /E /I /Y",
    "unzip-python": "powershell -command \"Expand-Archive -Path ./python-embed.zip -DestinationPath ./python-embed -Force\"",
    "package": "npm run unzip-python && electron-builder"
  },
  "build": {
    "asar": false,
    "appId": "com.tuempresa.tuapp",
    "productName": "electron-app",
    "files": [
      "main.js",
      "package.json",
      "backend",
      "frontend",
      "python-embed"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^25.1.8"
  }
}
