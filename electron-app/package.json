{
  "name": "electron-app",
  "version": "1.0.0",
  "description": "App Electron con Django + SQLite",
  "main": "main.js",
  "scripts": {
    "start": "npm run build-frontend && electron .",
    "build-frontend": "cd ../frontend && npm install && npm run build && xcopy dist ..\\electron-app\\frontend\\dist /E /I /Y",
    "package": "electron-builder"
  },
  "build": {
  "asar": false,
  "appId": "com.tuempresa.tuapp",
  "productName": "electron-app",
  "files": [
    "main.js",
    "package.json",
    "frontend/dist/**/*",
    "backend/**/*"
  ],
  "extraResources": [
    {
      "from": "frontend/dist/",
      "to": "frontend/dist"
    }
  ]
},
    "win": {
      "target": "nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  }
}
